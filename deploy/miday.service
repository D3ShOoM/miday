# systemd user service — keeps Miday running after you log out.
#   mkdir -p ~/.config/systemd/user
#   cp deploy/miday.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now miday
#   sudo loginctl enable-linger "$USER"   # start at boot, without logging in
# Logs: journalctl --user -u miday -f
[Unit]
Description=Miday
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/miday
ExecStart=%h/miday/run.sh
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
