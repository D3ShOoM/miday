# Miday settings. run.sh copies this file to .env on first run
# and adds DJANGO_SECRET_KEY. Restart run.sh after changing anything.

# Address colleagues use to open the app; share links are built from it.
# Leave blank to use this machine's LAN IP (run.sh detects it).
PUBLIC_BASE_URL=
PORT=8000

# Optional: Google Maps Platform API key. Enable "Places API (New)" and
# "Maps Grounding Lite" for its project; see README.md.
GOOGLE_MAPS_API_KEY=
# At most this many billable Place Details lookups per day (1,000/month are free).
GMAPS_DAILY_DETAILS_CAP=50

# Unofficial keyless lookup through the Google Maps website (1 = on, 0 = off).
GMAPS_KEYLESS=1

# Language and region for Google results.
GMAPS_LANGUAGE=en
GMAPS_REGION=SA

# SQLite's WAL mode needs a local disk; use 0 on network storage (PythonAnywhere).
SQLITE_WAL=1

# How often an open voting page checks for new votes, in seconds.
LIVE_REFRESH_SECONDS=4

# Time zone for the times shown on pages, such as "closes at 13:30".
TIME_ZONE=Asia/Riyadh

# If this machine reaches the internet through a proxy:
# HTTPS_PROXY=http://proxy.example.com:8080
